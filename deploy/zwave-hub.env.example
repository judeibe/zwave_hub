# zwave-hub configuration, by example.
#
# Copy this file to deploy/.env, edit what you need, then `make image && make up`.
# Every ZWAVE_HUB_* variable here is read exactly once at startup by
# internal/config; a flag of the same name overrides it for one run, except
# ZWAVE_HUB_MASTER_KEY, which deliberately has no flag because a command line is
# visible in ps and in the container's inspect output.
#
# Compose reads deploy/.env twice: to interpolate the ${...} references in
# deploy/compose.yaml and as the container's env file. That is why DIALOUT_GID,
# a compose-time value the hub never sees, lives in the same file.
#
# Plain KEY=value lines only: no `export`, no quoting, no shell logic. An empty
# value is treated as unset, so `ZWAVE_HUB_LOG_LEVEL=` means "use the default".

# HTTP listen address, host:port. The API is unauthenticated (FR-020), so this
# address is the trust boundary: whoever can reach it can include and exclude
# devices and export the network keys. Keep it on 0.0.0.0 only on a private
# network or behind a firewall; otherwise bind a single interface or 127.0.0.1
# and put your own proxy in front. The host must be an IP address or localhost
# (empty is allowed), and the port must be 1-65535, or startup fails.
ZWAVE_HUB_BIND=0.0.0.0:8080

# Directory holding hub.db, master.key when ZWAVE_HUB_MASTER_KEY is unset, and
# the zwave-js cache. /data is the path the image declares as its volume;
# changing it without also moving that volume writes state outside the persisted
# mount, and a container recreate silently starts from an empty hub.
ZWAVE_HUB_DATA_DIR=/data

# Base64 of exactly 32 bytes (the AES-256 key for the stored network keys).
# Unset by default: the hub then keeps the key in <data>/master.key, mode 0600,
# written there on first start when the file is absent. That protects the
# database file alone (a copied backup, a stray mount) but not the host, and not
# against losing the key together with the database.
#
# Recommended for anything beyond a lab: generate one key, keep it in the host's
# secret store, and inject it at run time. With it set, an attacker who reads
# the data volume gets ciphertext only, and a lost volume is recoverable as long
# as the keys or this master key survive. Generate it with:
#
#   head -c 32 /dev/urandom | base64
#
# Setting it in this file, rather than in the secret store, puts key material in
# a plain-text file that is easy to copy to a laptop and back up by accident.
# deploy/.env is git-ignored, but git-ignored is not secret.
#
# A value that is not base64 of exactly 32 bytes stops the hub at startup with
# hub.config_invalid; the error names the variable and never echoes the value.
#ZWAVE_HUB_MASTER_KEY=

# Event floor: debug, info, warn or error. info in production. debug is for
# development only; it can include the sidecar's verbose output, so turn it on
# to diagnose a problem and off again, rather than leaving it set.
ZWAVE_HUB_LOG_LEVEL=info

# Gate for POST /api/v1/network/reset: enabled or disabled. `disabled` returns
# 503 destructive_ops_disabled and is the emergency switch: no rebuild, no code
# change, only an updated value and a container recreate. It closes that one
# call and nothing else — reads, key rewrites and driver restarts still work —
# so it buys time without taking the hub out of service.
ZWAVE_HUB_DESTRUCTIVE_OPS=enabled

# Sysfs poll period for the stick, as a Go duration: 2s, 1500ms, 1m. Values
# below 500ms are rejected at startup: a faster poll costs sysfs reads forever
# and cannot surface a plug-in sooner than the kernel settles it. Raise it only
# if a large number of serial devices makes the scan itself expensive.
ZWAVE_HUB_DISCOVERY_INTERVAL=2s

# hardware or mock. `mock` replaces the stick with zwave-server --mock-driver:
# development and contract tests only. Never set it in a deployed container —
# the hub would report a fake coordinator, look healthy on /readyz, and operate
# on nothing real.
ZWAVE_HUB_DRIVER_MODE=hardware

# Where @zwave-js/server is installed inside the image. The default matches
# deploy/Dockerfile; change it only if you build an image that places the
# sidecar elsewhere, or the supervisor cannot spawn it and reports
# driver.failed with reason spawn_failed.
ZWAVE_HUB_SIDECAR_DIR=/opt/zwave-sidecar

# Compose-time only: the host's dialout GID, used in group_add so the
# container's non-root user may open the serial node. The hub never reads it.
# Find the host's value with:
#
#   stat -c '%g' /dev/ttyUSB0
#
# A mismatch is the usual cause of support_reason: permission_denied on a stick
# that is plainly attached, and retrying the driver never fixes it.
DIALOUT_GID=20

# How to use
# ----------
#   cp deploy/zwave-hub.env.example deploy/.env
#   $EDITOR deploy/.env
#   make image && make up
#
# deploy/.env is git-ignored (see .gitignore), so an edited copy never enters a
# commit. If you set ZWAVE_HUB_MASTER_KEY at all, keep a copy of it outside this
# host too: losing it makes every stored network key unreadable, and only
# re-supplying the keys or a full reset recovers (quickstart.md §7.2, §7.4).
